# Local secrets/config for the judgment eval harness.
#
# HOW TO USE:
#   1. Copy this file to `.env.local` in this same directory:
#          cp evals/judgment/.env.local.example evals/judgment/.env.local
#   2. Put your real Anthropic API key in it (see below).
#   3. `.env.local` is gitignored and will NEVER be committed. Do not commit your key.
#
# common.py loads `.env` then `.env.local` from this directory into the process environment
# BEFORE reading its defaults. A real environment variable (if already set) always wins; among
# files, `.env.local` overrides `.env`.

# REQUIRED for a live/paid run — an Anthropic API key from console.anthropic.com (starts with sk-ant-).
# This is the pay-per-token API, billed separately from any Claude.ai subscription.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# OPTIONAL — uncomment to make live the default and/or pin the model (same model is used for all arms).
# AIDAN_EVAL_MODE=live
# AIDAN_EVAL_MODEL=claude-opus-4-8
